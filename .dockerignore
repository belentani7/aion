# .dockerignore - Files/directories to ignore in Docker build context

# Version control
.git
.gitignore

# Documentation
docs/
*.md
!cloudbuild.yaml
!trigger.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example

# Test files
tests/
*.test.ts
*.spec.ts
*.test.tsx
*.spec.tsx

# Local development
*.local.*

# Database
*.sql
*.sqlite
*.db

# Coverage reports
*.lcov

# TypeScript cache
*.tsbuildinfo

# GitHub
.github/