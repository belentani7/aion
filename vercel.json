{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci --ignore-scripts --legacy-peer-deps",
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api" },
    { "src": "^/manus-storage/.*$", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
