# Copy to .env and fill in real values. Never commit the real .env.

# --- Server ---
# Node environment: "development" enables the Vite dev middleware.
NODE_ENV=development
# Port the Express server listens on (falls back to the next free port).
PORT=3000

# --- Database (MySQL / Drizzle) ---
DATABASE_URL=mysql://user:password@localhost:3306/aion_core
# Optional: max connections in the mysql2 pool (default 10).
DB_POOL_MAX=10

# --- Session / auth ---
# Signing secret for the app_session_id JWT.
JWT_SECRET=replace_with_a_long_random_string
# Manus OAuth application id.
VITE_APP_ID=
# Manus OAuth server base URL (used by server/_core/sdk.ts).
OAUTH_SERVER_URL=
# openId of the project owner; this user is auto-promoted to role=admin.
OWNER_OPEN_ID=

# --- Manus Forge services (storage, LLM, maps, notifications, heartbeat) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Client (Vite exposes only VITE_* to the browser) ---
# OAuth portal used by startLogin() in client/src/const.ts.
VITE_OAUTH_PORTAL_URL=
# Optional Maps JavaScript API browser key. PUBLIC in bundles: restrict
# Google Cloud HTTP referrers and Maps API scope. Never use a Forge server token.
VITE_GOOGLE_MAPS_BROWSER_KEY=
