# Copy to .env and replace the placeholders. Never commit the real .env.

# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=aion_workforce
MYSQL_USER=aion_user
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

# Application
APP_PORT=3000
CLIENT_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Stripe (optional — billing features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# AION Agent workspace (optional)
AION_WORKSPACE_ROOT=
AION_AGENT_APPROVED=NO

# Compliance service
COMPLIANCE_JURISDICTION=ES
COMPLIANCE_PORT=8080

# Scheduling service (OR-Tools optimizer)
SCHEDULING_PORT=8081

# Diligence Protocol service (risk, workflows, reports)
DILIGENCE_PORT=8082
